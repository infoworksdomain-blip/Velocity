# Database
# DATABASE_URL: migration/admin connection (table owner — bypasses RLS, never used for request-scoped queries)
# DATABASE_URL_APP: application runtime connection (velocity_app role — RLS-scoped, see ADR 0003)
DATABASE_URL=postgres://velocity:velocity@localhost:5432/velocity
DATABASE_URL_APP=postgres://velocity_app:velocity_app_dev@localhost:5432/velocity
REDIS_URL=redis://localhost:6379

# Encryption (STEP 2 design decision 2 — local-dev KMS adapter, packages/db/src/kms.ts)
# 64 hex characters (32 bytes) for AES-256-GCM. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=velocity-media
R2_PUBLIC_CDN_URL=

# Auth
AUTH_SECRET=
SESSION_SECRET=
# Base URL this app is served from — used to build real links (password
# reset, workspace invitation accept) embedded in outgoing emails.
# Defaults to http://localhost:3000 in code if unset.
APP_BASE_URL=http://localhost:3000

# Email (post-STEP-22 audit remediation — packages/core/src/auth/email-provider.ts)
# Optional: createEmailProvider() falls back to a console-log dev provider
# when RESEND_API_KEY is unset, so nothing throws at startup without it.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@velocity.app

# Text engine (STEP 8B)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Remotion Lambda compositor (post-STEP-22 audit remediation — ADR 0002)
# Optional: apps/worker's getCompositor() falls back to StubCompositor
# unless all three are set (see temporal/activities/context.ts's
# readRemotionLambdaConfig). Produced by `pnpm --filter @velocity/render
# deploy:lambda` (see apps/render/scripts/deploy-lambda.ts) once a real
# AWS account/Lambda function exists.
REMOTION_AWS_REGION=
REMOTION_AWS_LAMBDA_FUNCTION_NAME=
REMOTION_SITE_URL=
# Consumed by the deploy script itself, not by apps/worker at runtime —
# infra/terraform's regional-stack module's own remotion_lambda_role_arn
# output.
REMOTION_LAMBDA_ROLE_ARN=

# Video/image providers (STEP 8) — add only the ones configured locally
KLING_API_KEY=
VEO_API_KEY=
SEEDANCE_API_KEY=
MINIMAX_API_KEY=
WAN_API_KEY=
SEEDREAM_API_KEY=
ELEVENLABS_API_KEY=

# Social platform OAuth (STEP 11)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Real Stripe Price ids for each paid plan (STEP 19) — resolveStripePriceId
# throws a clear error at checkout-creation time if one of these is unset
# for a plan a workspace tries to subscribe to; there is no free-plan
# entry because the free plan has no Stripe subscription to create.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Observability
SENTRY_DSN=
POSTHOG_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
