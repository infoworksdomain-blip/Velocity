    "gate:11": "tsx scripts/gate-11/index.ts",
    "gate:12": "tsx scripts/gate-12/index.ts",
    "gate:13": "tsx scripts/gate-13/index.ts",
    "gate:14": "tsx scripts/gate-14/index.ts",
    "gate:15": "tsx scripts/gate-15/index.ts",
    "gate:16": "tsx scripts/gate-16/index.ts",
    "gate:17": "tsx scripts/gate-17/index.ts",
    "gate:18": "tsx scripts/gate-18/index.ts",
    "gate:19": "tsx scripts/gate-19/index.ts",
    "gate:20": "tsx scripts/gate-20/index.ts",
