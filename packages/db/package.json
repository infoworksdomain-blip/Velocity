{
  "name": "@velocity/db",
  "private": true,
  "version": "0.0.0",
  "description": "Drizzle schema, hand-rolled up/down migrator, RLS policies, KMS abstraction, and seed data (STEP 2, ADR 0003).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "@types/pg": "^8.11.10",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "test": "vitest run",
    "push": "echo \"@velocity/db: use migrate/migrate:down, not drizzle-kit push — schema changes are versioned migrations from STEP 2 onward\"",
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "seed": "tsx seed/seed.ts"
  }
}
