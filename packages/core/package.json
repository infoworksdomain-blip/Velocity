{
  "name": "@velocity/core",
  "private": true,
  "version": "0.0.0",
  "description": "Shared domain types and business logic. See /docs/architecture/domain-model.md — the domain types are the compiled mirror of that document. RBAC (STEP 3) and auth primitives (password hashing, TOTP MFA, session tokens, OAuth adapters) live here too, per STEP 1's monorepo layout.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./onboarding": {
      "types": "./dist/onboarding/state-machine.d.ts",
      "default": "./dist/onboarding/state-machine.js"
    },
    "./*": "./dist/*"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "otpauth": "^9.3.6",
    "drizzle-orm": "^0.38.2",
    "zod": "^3.24.1",
    "@velocity/db": "workspace:*",
    "@velocity/contracts": "workspace:*",
    "@velocity/text-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "vitest": "^2.1.8",
    "@velocity/providers": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  }
}
