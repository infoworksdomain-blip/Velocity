{
  "name": "@velocity/worker",
  "private": true,
  "version": "0.0.0",
  "description": "BullMQ short-job consumer and Temporal worker process (ADR 0001). Render workflow (STEP 8) registered here — resolveAssets -> generateShots -> generateVO -> align -> composeText -> compose -> normalise -> provenance -> qc -> publishReady. Publish workflow lands in STEP 12.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm build && vitest run",
    "test:concurrency": "pnpm build && vitest run --config vitest.concurrency.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.986.0",
    "@remotion/lambda": "4.0.499",
    "@temporalio/client": "1.11.7",
    "@temporalio/common": "1.11.7",
    "@temporalio/worker": "1.11.7",
    "@temporalio/workflow": "1.11.7",
    "@velocity/contracts": "workspace:*",
    "@velocity/core": "workspace:*",
    "@velocity/db": "workspace:*",
    "@velocity/providers": "workspace:*",
    "@velocity/text-engine": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@temporalio/testing": "1.11.7",
    "@types/node": "^22.10.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
